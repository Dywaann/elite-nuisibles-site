---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions fréquentes' } = Astro.props;
---
<section class="section" aria-labelledby="titre-faq">
  <div class="container narrow">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2 id="titre-faq" class="h2">{title}</h2>
    </div>
    <div class="faq">
      {items.map((i) => (
        <details class="glass reveal">
          <summary>{i.q}<Icon name="chevron" /></summary>
          <p>{i.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
