---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { SITE } from '../data/site';
interface Props { source: string; title?: string }
const { source, title = 'Obtenir un devis immédiat' } = Astro.props;
---
<section class="section" style="padding-top:28px">
  <div class="container">
    <div class="split" style="align-items:flex-start">
      <div class="stack" style="flex:1 1 360px;gap:14px">
        <a href={SITE.phoneHref} data-cta="appel" class="btn btn-call" style="min-height:92px;border-radius:24px;justify-content:flex-start;padding:0 24px;gap:16px">
          <Icon name="phone" size={28} />
          <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2"><small style="font-size:13px;font-weight:700">Appel gratuit · 24h/24 · 7j/7</small><b style="font-size:26px">{SITE.phone}</b></span>
        </a>
        <div class="glass feature"><span class="ico"><Icon name="mail" size={22} /></span><div><h3 style="font-size:14px;font-weight:600;color:var(--muted)">Email</h3><p style="margin:0"><a href={`mailto:${SITE.email}`} class="one-line email" style="font-weight:700;color:var(--navy)">{SITE.email}</a></p></div></div>
        <div class="glass feature"><span class="ico"><Icon name="clock" size={22} /></span><div><h3 style="font-size:14px;font-weight:600;color:var(--muted)">Disponibilité</h3><p style="margin:0;font-weight:700;color:var(--navy)">7j/7, 24h/24</p></div></div>
        <div class="glass feature"><span class="ico"><Icon name="pin" size={22} /></span><div><h3 style="font-size:14px;font-weight:600;color:var(--muted)">Siège</h3><p style="margin:0;font-weight:700;color:var(--navy)">{SITE.address.street}, {SITE.address.zip} {SITE.address.city}</p></div></div>
        <p class="muted note-c" style="font-size:15px">Une question ? Nos experts vous conseillent gratuitement par téléphone.</p>
      </div>
      <div style="flex:1.2 1 380px;min-width:0"><LeadForm id="devis" source={source} title={title} subtitle="Un expert vous appelle avec votre devis." button="J'obtiens mon devis maintenant" message /></div>
    </div>
  </div>
</section>
