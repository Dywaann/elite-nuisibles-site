---
import { ZONES } from '../data/site';
---
<section class="section" aria-labelledby="titre-zones">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Zone d'intervention</span>
      <h2 id="titre-zones" class="h2 center">Présents partout en Île-de-France</h2>
      <p class="lead center">Intervention en moins d'1h sur Paris et la petite couronne, et dans les meilleurs délais sur le reste de la région.</p>
    </div>
    <div class="grid zones-grid">
      {ZONES.map((z) => (
        <div class="glass zone reveal">
          <span class="code">{z.code}</span>
          <div><h3>{z.name}</h3><p>{z.cities}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
