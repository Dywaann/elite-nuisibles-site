---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import CallButton from '../components/CallButton.astro';
import LeadForm from '../components/LeadForm.astro';
import Clients from '../components/Clients.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Engagements from '../components/Engagements.astro';
import Reviews from '../components/Reviews.astro';
import Zones from '../components/Zones.astro';
import Faq from '../components/Faq.astro';
import ConversionBlock from '../components/ConversionBlock.astro';
import FinalCta from '../components/FinalCta.astro';
import PostCard from '../components/PostCard.astro';
import { GENERAL_FAQ, HOME_SERVICES, PESTS_ALL, SITE } from '../data/site';
import { ARTICLES } from '../lib/articles';
import { faqLd, localBusinessLd } from '../lib/seo';

const hero = '/images/techniciens-desinsectisation-logement-ile-de-france.webp';
---
<Base
  title="Dératisation & désinsectisation Paris et Île-de-France | 7j/7"
  description="Dératisation et désinsectisation à Paris et dans toute l'Île-de-France, 7j/7. Intervention rapide, devis gratuit, prix fixes. ☎ 01 79 75 30 40"
  path="/"
  jsonLd={[localBusinessLd(), faqLd(GENERAL_FAQ)]}
  preloadImage={hero}
>
  <div class="container">
    <section class="hero">
      <span class="chip chip-navy"><i class="dot" aria-hidden="true"></i>Urgence 24h/24 · Intervention en moins d'1h</span>
      <h1 class="h1">Dératisation et désinsectisation à Paris et en <span class="hl">Île-de-France</span></h1>
      <p class="lead">Rats, punaises de lit, cafards : un technicien certifié chez vous, partout en Île-de-France. Prix fixe, annoncé avant d'intervenir.</p>
      <div class="cta-row">
        <CallButton large />
        <a href="#rappel" class="btn btn-ghost btn-lg m-hide" style="font-size:17px">Être rappelé en 20 min</a>
      </div>
      <ul class="pills center">
        <li><Icon name="check" size={18} stroke={2.8} />Déplacement gratuit</li>
        <li><Icon name="check" size={18} stroke={2.8} />Prix fixe annoncé</li>
        <li><Icon name="check" size={18} stroke={2.8} />Certifié Certibiocide</li>
      </ul>
      <a class="rating" href="#avis"><Stars label={`Note ${SITE.rating.value} sur 5`} />{SITE.rating.value}/5 sur {SITE.rating.count} avis Google</a>
    </section>

    <section class="split" style="margin-bottom:32px">
      <div class="photo split-main">
        <img src={hero} alt="Techniciens Élite Nuisibles traitant un logement en Île-de-France" width="1000" height="1000" fetchpriority="high" />
        <span class="float end"><Icon name="shield" size={18} />Entreprise assurée</span>
        <span class="float start"><i class="dot" aria-hidden="true"></i><span>Joignable 24h/24, 7j/7</span></span>
      </div>
      <div class="split-side"><LeadForm source="Site principal - Accueil" /></div>
    </section>

    <Clients />

    <div style="margin-top:56px"><KeyFigures /></div>
  </div>

  <section id="services" class="section" aria-labelledby="titre-services">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Nos interventions</span>
        <h2 id="titre-services" class="h2">Un prix fixe, annoncé avant l'intervention</h2>
      </div>
      <div class="grid grid-3 m-scroll">
        {HOME_SERVICES.map((s) => (
          <a class="glass card reveal" href={s.to}>
            <span class="price-from">à partir de</span>
            <span class="price">{s.from}</span>
            <h3 class="h3" style="margin-top:8px;font-size:22px">{s.title}</h3>
            <p class="muted" style="font-size:15px">{s.text}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
      <div class="glass card pest-band reveal" style="margin-top:20px">
        <h3 class="h3">Tous les nuisibles traités</h3>
        <ul class="pest-chips">
          {PESTS_ALL.map((p) => <li><a href={p.to}>{p.name}</a></li>)}
        </ul>
        <a class="link-arrow" href="/services-lutte-nuisibles-paris/">Tous nos services <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <Engagements />

  <section class="section" aria-labelledby="titre-apropos">
    <div class="container">
      <div class="split" style="align-items:center;gap:40px">
        <figure class="media split-side reveal" style="flex:1 1 420px;aspect-ratio:4/3">
          <img src="/images/technicien-anti-nuisibles-pulverisation-exterieur.webp" alt="Technicien Élite Nuisibles pulvérisant un traitement anti-nuisibles en extérieur" loading="lazy" width="1600" height="766" />
        </figure>
        <div class="stack txt-c reveal" style="flex:1 1 420px;gap:16px">
          <span class="eyebrow">Qui sommes-nous</span>
          <h2 id="titre-apropos" class="h2">Une entreprise francilienne, des techniciens certifiés</h2>
          <p class="lead">Depuis 2021, nos techniciens certifiés Certibiocide protègent logements et locaux professionnels, à Paris et partout en Île-de-France.</p>
          <blockquote class="glass" style="padding:20px 22px;border-radius:20px">
            <p style="font-style:italic">« Notre mission est de garantir un environnement sain et sécurisé pour tous nos clients. »</p>
            <p style="margin-top:8px;font-size:14px;font-weight:800">Bastien Gaumet, Directeur</p>
          </blockquote>
          <div class="cta-row">
            <a class="btn btn-navy" href="/qui-sommes-nous/">Découvrir l'entreprise</a>
            <img src="/images/certification-certibiocide.webp" alt="Certification Certibiocide, traitements raisonnés" width="170" height="89" loading="lazy" style="height:52px;width:auto;border-radius:8px" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <Zones />

  <section class="section" aria-labelledby="titre-blog">
    <div class="container">
      <div class="review-head reveal">
        <div class="stack" style="gap:10px">
          <span class="eyebrow">Conseils d'experts</span>
          <h2 id="titre-blog" class="h2">Nos derniers conseils</h2>
        </div>
        <a class="link-arrow" href="/blog/">Tous les articles <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid grid-3 m-scroll">
        {ARTICLES.slice(0, 3).map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <ConversionBlock source="Site principal - Accueil" />
  <Faq items={GENERAL_FAQ} />
  <FinalCta />
</Base>
