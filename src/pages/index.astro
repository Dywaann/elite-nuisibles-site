---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import CallButton from '../components/CallButton.astro';
import LeadForm from '../components/LeadForm.astro';
import Clients from '../components/Clients.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Engagements from '../components/Engagements.astro';
import Reviews from '../components/Reviews.astro';
import Zones from '../components/Zones.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import PostCard from '../components/PostCard.astro';
import { GENERAL_FAQ, HOME_SERVICES, PESTS_ALL, SITE } from '../data/site';
import { ARTICLES } from '../lib/articles';
import { faqLd, localBusinessLd } from '../lib/seo';

const hero = '/images/hero-techniciens-traitement-nuisibles.webp';
---
<Base
  title="Dératisation Paris & Désinsectisation IDF | Intervention 1h"
  description="Entreprise de dératisation Paris et IDF. Intervention en moins d'1h, 7j/7. Devis gratuit, prix fixes. Punaises de lit, rats, cafards. ☎ 01 79 75 30 40"
  path="/"
  jsonLd={[localBusinessLd(), faqLd(GENERAL_FAQ)]}
  preloadImage={hero}
>
  <div class="container">
    <section class="hero">
      <span class="chip chip-navy"><i class="dot" aria-hidden="true"></i>Urgence 24h/24 · Intervention en moins d'1h · 7j/7</span>
      <h1 class="h1">Dératisation Paris &amp; désinsectisation en <span class="hl">Île-de-France</span></h1>
      <p class="lead">Rats, souris, punaises de lit, cafards, fourmis : un technicien certifié chez vous rapidement, avec un prix fixe annoncé avant l'intervention.</p>
      <div class="cta-row">
        <CallButton large />
        <a href="#rappel" class="btn btn-ghost btn-lg" style="font-size:17px">Être rappelé en 20 minutes</a>
      </div>
      <ul class="pills center">
        <li><Icon name="check" size={18} stroke={2.8} />Déplacement et devis gratuits</li>
        <li><Icon name="check" size={18} stroke={2.8} />Prix fixes, connus à l'avance</li>
        <li><Icon name="check" size={18} stroke={2.8} />Techniciens certifiés Certibiocide</li>
      </ul>
      <a class="rating" href="#avis"><Stars label={`Note ${SITE.rating.value} sur 5`} />{SITE.rating.value}/5 sur {SITE.rating.count} avis Google</a>
    </section>

    <section class="split" style="margin-bottom:32px">
      <div class="photo split-main">
        <img src={hero} alt="Techniciens Élite Nuisibles en combinaison traitant un salon" width="1000" height="1000" fetchpriority="high" />
        <span class="float end"><Icon name="shield" size={18} />Entreprise assurée, RC professionnelle</span>
        <span class="float start"><i class="dot" aria-hidden="true"></i><span>Joignable 24h/24, 7j/7<small>Paris et petite couronne en moins d'1h</small></span></span>
      </div>
      <div class="split-side"><LeadForm source="Site principal - Accueil" /></div>
    </section>

    <Clients />

    <div style="margin-top:56px"><KeyFigures /></div>
  </div>

  <section id="services" class="section" aria-labelledby="titre-services">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">Nos interventions</span>
        <h2 id="titre-services" class="h2 center">Un prix fixe, annoncé avant l'intervention</h2>
      </div>
      <div class="grid grid-3">
        {HOME_SERVICES.map((s) => (
          <a class="glass card reveal" href={s.to}>
            <span class="price-from">à partir de</span>
            <span class="price">{s.from}</span>
            <h3 class="h3" style="margin-top:8px;font-size:22px">{s.title}</h3>
            <p class="muted" style="font-size:15px">{s.text}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
      <div class="glass card reveal" style="margin-top:20px">
        <h3 class="h3">Tous les nuisibles que nous traitons</h3>
        <ul class="grid grid-3" style="gap:10px 28px;font-size:15px">
          {PESTS_ALL.map((p) => <li class="muted"><a href={p.to} style="font-weight:800;color:var(--navy)">{p.name}</a> : {p.desc}</li>)}
        </ul>
        <a class="link-arrow" href="/services-lutte-nuisibles-paris/">Voir tous nos services <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <Engagements />

  <section class="section" aria-labelledby="titre-apropos">
    <div class="container">
      <div class="split" style="align-items:center;gap:40px">
        <figure class="media split-side reveal" style="flex:1 1 420px;aspect-ratio:4/3">
          <img src="/images/technicien-pulverisation-exterieur.webp" alt="Technicien Élite Nuisibles pulvérisant un traitement en extérieur" loading="lazy" width="1600" height="766" />
        </figure>
        <div class="stack reveal" style="flex:1 1 420px;gap:16px">
          <span class="eyebrow">Qui sommes-nous</span>
          <h2 id="titre-apropos" class="h2">Une entreprise francilienne, des techniciens certifiés</h2>
          <p class="lead">Fondée en 2021, Elite Nuisibles IDF est spécialisée dans la lutte contre les nuisibles. Nos techniciens certifiés Certibiocide interviennent chez les particuliers comme chez les professionnels, avec des méthodes éprouvées et un suivi rigoureux.</p>
          <blockquote class="glass" style="padding:20px 22px;border-radius:20px">
            <p style="font-style:italic">« Notre mission est de garantir un environnement sain et sécurisé pour tous nos clients. »</p>
            <p style="margin-top:8px;font-size:14px;font-weight:800">Bastien Gaumet, Directeur</p>
          </blockquote>
          <div class="cta-row">
            <a class="btn btn-navy" href="/qui-sommes-nous/">Découvrir l'entreprise</a>
            <img src="/images/certibiocide.webp" alt="Agréé Certibiocide, traitements raisonnés" width="170" height="89" loading="lazy" style="height:52px;width:auto;border-radius:8px" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <Zones />

  <section class="section" aria-labelledby="titre-blog">
    <div class="container">
      <div class="review-head reveal">
        <div class="stack" style="gap:10px">
          <span class="eyebrow">Conseils d'experts</span>
          <h2 id="titre-blog" class="h2">Nos derniers articles</h2>
        </div>
        <a class="link-arrow" href="/blog/">Tous les articles <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid grid-3">
        {ARTICLES.slice(0, 3).map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <Faq items={GENERAL_FAQ} />
  <FinalCta />
</Base>
