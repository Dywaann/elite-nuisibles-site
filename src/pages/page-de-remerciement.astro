---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CallButton from '../components/CallButton.astro';
---
<Base title="Demande bien reçue | Elite Nuisibles IDF" description="Votre demande a bien été reçue par Elite Nuisibles IDF. Un expert vous appelle avec votre devis dans les plus brefs délais." path="/page-de-remerciement/" noindex>
  <section class="section">
    <div class="container narrow">
      <div class="glass card center" style="align-items:center;padding:48px 28px;gap:18px">
        <span style="display:flex;align-items:center;justify-content:center;width:72px;height:72px;border-radius:50%;background:var(--go);color:var(--navy)"><Icon name="check" size={36} stroke={3} /></span>
        <h1 class="h1" style="font-size:clamp(28px,4vw,40px)">Merci, votre demande est bien reçue !</h1>
        <p class="lead">Un expert Elite Nuisibles vous appelle avec votre devis en moins de 20 minutes. Pour une urgence, appelez-nous directement.</p>
        <div class="cta-row center"><CallButton /><a class="btn btn-ghost" href="/">Retour à l'accueil</a></div>
      </div>
    </div>
  </section>
  <script is:inline>window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'thank_you_page' });</script>
</Base>
