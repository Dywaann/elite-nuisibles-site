---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../components/PostCard.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE } from '../../data/site';
import { ARTICLES } from '../../lib/articles';
import { breadcrumbLd } from '../../lib/seo';
const path = '/blog/';
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Blog', path }];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Le blog Elite Nuisibles IDF',
  url: `${SITE.url}/blog/`,
  blogPost: ARTICLES.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE.url}/${p.slug}/`, datePublished: p.date })),
};
---
<Base
  title="Blog : guide pratique contre les nuisibles | Elite Nuisibles IDF"
  description="Conseils d’experts pour prévenir et traiter rats, souris, punaises de lit, cafards et fourmis en Île-de-France. Le guide pratique d’Elite Nuisibles IDF."
  path={path}
  jsonLd={[ld, breadcrumbLd(crumbs)]}
>
  <PageHead crumbs={crumbs} title="Guide pratique contre les nuisibles" intro="Nos conseils d'experts pour reconnaître, prévenir et traiter les infestations." />
  <section class="section" style="padding-top:28px">
    <div class="container"><div class="grid grid-3">{ARTICLES.map((p) => <PostCard post={p} heading="h2" />)}</div></div>
  </section>
  <FinalCta />
</Base>
