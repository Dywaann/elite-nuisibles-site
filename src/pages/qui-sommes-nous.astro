---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import CallButton from '../components/CallButton.astro';
import Reviews from '../components/Reviews.astro';
import Zones from '../components/Zones.astro';
import FinalCta from '../components/FinalCta.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ConversionBlock from '../components/ConversionBlock.astro';

import { breadcrumbLd, localBusinessLd } from '../lib/seo';

const path = '/qui-sommes-nous/';
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Qui sommes-nous ?', path }];
const VALEURS = [
  { icon: 'target', title: 'Notre mission', text: 'Éliminer les nuisibles vite et bien, sans risque pour vous ni pour l’environnement.' },
  { icon: 'leaf', title: 'Méthodes raisonnées', text: 'Le bon produit, au bon endroit, à la bonne dose.' },
  { icon: 'shield', title: 'Certifiés et assurés', text: 'Certification Certibiocide et responsabilité civile professionnelle.' },
  { icon: 'heart', title: 'Transparence', text: 'Déplacement gratuit, devis clair, prix fixe.' },
];
---
<Base
  title="Qui sommes-nous ? | Elite Nuisibles IDF"
  description="Elite Nuisibles IDF, entreprise fondée en 2021, intervient à Paris et dans toute l’Île-de-France : dératisation et désinsectisation pour particuliers et professionnels."
  path={path}
  jsonLd={[localBusinessLd(), breadcrumbLd(crumbs)]}
>
  <PageHead crumbs={crumbs} title="Qui sommes-nous ?" intro="Des artisans fiables, au service des particuliers et des professionnels, à Paris et dans toute l'Île-de-France.">
    <div class="cta-row"><CallButton /><a class="btn btn-ghost" href="#devis-bas">Mon devis gratuit en 20 min</a></div>
  </PageHead>
  <TrustStrip />
  <section class="section" style="padding-top:28px">
    <div class="container">
      <div class="split" style="align-items:center;gap:40px">
        <figure class="media reveal" style="flex:1 1 340px;aspect-ratio:4/5;max-height:600px">
          <img src="/images/technicien-traitement-punaises-de-lit-sommier.webp" alt="Technicien Élite Nuisibles traitant un sommier contre les punaises de lit" width="1600" height="2133" />
        </figure>
        <div class="stack txt-c reveal" style="flex:1.3 1 420px;gap:16px">
          <span class="eyebrow">Notre histoire</span>
          <h2 class="h2">Votre partenaire de confiance contre les nuisibles</h2>
          <div class="prose">
            <p>Depuis 2021, Elite Nuisibles IDF protège logements et locaux professionnels contre les nuisibles, à Paris et partout en Île-de-France.</p>
            <p>Nos techniciens certifiés Certibiocide interviennent 7j/7 dans les 8 départements, avec trois règles : arriver vite, annoncer le prix avant, obtenir un résultat durable.</p>
          </div>
          <blockquote class="glass" style="padding:22px 24px;border-radius:20px">
            <p style="font-style:italic;font-size:17px">« Notre mission chez Elite Nuisibles IDF est de garantir un environnement sain et sécurisé pour tous nos clients. »</p>
            <p style="margin-top:10px;font-size:14px;font-weight:800">Bastien Gaumet, Directeur</p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">L'amour du métier</span><h2 class="h2">Notre mission et nos valeurs</h2></div>
      <div class="grid grid-2 m-scroll">
        {VALEURS.map((e) => <div class="glass feature reveal"><span class="ico"><Icon name={e.icon} size={22} /></span><div><h3>{e.title}</h3><p>{e.text}</p></div></div>)}
      </div>
      <div class="cta-row center" style="margin-top:32px">
        <img src="/images/certification-certibiocide.webp" alt="Certification Certibiocide, traitements raisonnés" width="190" height="100" loading="lazy" style="height:56px;width:auto;border-radius:8px" />
        <CallButton />
      </div>
    </div>
  </section>
  <Reviews />
  <Zones />
  <ConversionBlock source="Site principal - Qui sommes-nous" title="Profitez d'un déplacement gratuit" text="Nos techniciens ne facturent pas le déplacement : nous établissons un devis selon votre situation, avant toute intervention." />
</Base>
