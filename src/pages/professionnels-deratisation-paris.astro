---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import CallButton from '../components/CallButton.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ConversionBlock from '../components/ConversionBlock.astro';
import Engagements from '../components/Engagements.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../data/site';
import { breadcrumbLd, faqLd, localBusinessLd } from '../lib/seo';

const path = '/professionnels-deratisation-paris/';
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Professionnels', path }];
const hero = '/images/technicien-desinsectisation-cuisine.webp';
const FAQ = [
  { q: 'Proposez-vous des contrats d’entretien pour les professionnels ?', a: 'Oui. Interventions ponctuelles ou contrats de suivi : passages réguliers, contrôle des postes, rapport.' },
  { q: 'Fournissez-vous un rapport pour les contrôles sanitaires ?', a: 'Oui : un rapport détaillé après chaque intervention, à présenter lors d’un contrôle d’hygiène.' },
  { q: 'Pouvez-vous intervenir en dehors des heures d’ouverture ?', a: 'Oui, 7j/7 : tôt le matin, le soir ou pendant la fermeture, sans gêner votre activité.' },
  { q: 'Intervenez-vous discrètement ?', a: 'Oui, avec des véhicules non marqués, pour préserver l’image de votre établissement.' },
];
const ENJEUX = [
  { icon: 'file', title: 'Conformité sanitaire', text: 'Des nuisibles peuvent entraîner sanctions et fermeture temporaire.' },
  { icon: 'star', title: 'Image de marque', text: 'Un nuisible vu par un client, et les avis en ligne s’en souviennent longtemps.' },
  { icon: 'alert', title: 'Sécurité alimentaire', text: 'En cuisine, ils contaminent les stocks et mettent vos clients en danger.' },
];
const SOLUTIONS = [
  { title: 'Rats et souris', text: 'Rongeurs éliminés, durablement.', perks: ['Postes d’appâtage sécurisés', 'Suivi régulier'] },
  { title: 'Insectes', text: 'Cafards, blattes, punaises de lit, fourmis.', perks: ['Élimination rapide', 'Prévention durable'] },
  { title: 'Rapport à chaque passage', text: 'À conserver pour vos contrôles d’hygiène.', perks: ['Zones traitées, produits utilisés', 'Recommandations'] },
];
const SECTEURS = ['Restaurants et bars', 'Hôtels et locations', 'Commerces', 'Bureaux et copropriétés'];
---
<Base
  title="Dératisation et désinsectisation pour professionnels à Paris | Elite Nuisibles IDF"
  description="Solutions de dératisation et désinsectisation sur-mesure pour hôtels, restaurants, bureaux et commerces à Paris. Intervention rapide et discrète, rapport d’intervention."
  path={path}
  image={hero}
  jsonLd={[localBusinessLd(), faqLd(FAQ), breadcrumbLd(crumbs)]}
  preloadImage={hero}
>
  <div class="container">
    <section class="hero">
      <nav aria-label="Fil d'Ariane"><ol class="crumbs"><li><a href="/">Accueil</a></li><li><span aria-current="page">Professionnels</span></li></ol></nav>
      <span class="chip chip-navy"><i class="dot" aria-hidden="true"></i>Hôtels, restaurants et commerces</span>
      <h1 class="h1">Dératisation et désinsectisation pour les professionnels</h1>
      <p class="lead">Protégez votre établissement et votre réputation, sans gêner votre activité.</p>
      <div class="cta-row">
        <CallButton large />
        <a href="#rappel" class="btn btn-ghost btn-lg m-hide" style="font-size:17px">Devis gratuit en 20 min</a>
      </div>
      <ul class="pills center">
        <li><Icon name="check" size={18} stroke={2.8} />Intervention discrète, hors horaires</li>
        <li><Icon name="check" size={18} stroke={2.8} />Rapport pour vos contrôles</li>
        <li><Icon name="check" size={18} stroke={2.8} />Contrats de suivi sur-mesure</li>
      </ul>
      <a class="rating" href="#avis"><Stars label={`Note ${SITE.rating.value} sur 5`} />{SITE.rating.value}/5 sur {SITE.rating.count} avis Google</a>
    </section>

    <section class="split" style="margin-bottom:32px">
      <div class="photo split-main">
        <img src={hero} alt="Technicien traitant une cuisine professionnelle" width="1600" height="673" fetchpriority="high" />
        <span class="float end"><Icon name="shield" size={18} />Entreprise assurée</span>
        <span class="float start"><i class="dot" aria-hidden="true"></i><span>Joignable 24h/24, 7j/7</span></span>
      </div>
      <div class="split-side">
        <LeadForm source="Site principal - Professionnels" service="Professionnel - Dératisation / désinsectisation" title="Devis professionnel gratuit" subtitle="Un expert vous rappelle. Gratuit, sans engagement." button="J'obtiens mon devis" />
      </div>
    </section>
  </div>

  <TrustStrip />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Pourquoi agir</span>
        <h2 class="h2">Ce qu'une infestation coûte à un établissement</h2>
        <p class="lead">Un contrôle sanitaire défavorable, des avis négatifs, des clients perdus.</p>
      </div>
      <div class="grid grid-3 m-scroll">
        {ENJEUX.map((e) => <div class="glass feature reveal"><span class="ico"><Icon name={e.icon} size={22} /></span><div><h3>{e.title}</h3><p>{e.text}</p></div></div>)}
      </div>
    </div>
  </section>

  <div class="container">
    <section class="dark reveal">
      <div class="section-head" style="margin-bottom:28px"><span class="eyebrow">Nos solutions</span><h2 class="h2">Une protection totale et durable</h2></div>
      <div class="grid grid-3 m-scroll" style="gap:16px">
        {SOLUTIONS.map((s) => <div class="tile"><h3>{s.title}</h3><p>{s.text}</p><ul>{s.perks.map((k) => <li><Icon name="check" size={16} stroke={2.8} />{k}</li>)}</ul></div>)}
      </div>
      <ul class="pills" style="margin-top:24px">
        {SECTEURS.map((s) => <li style="background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.22);color:#fff"><Icon name="building" size={18} />{s}</li>)}
      </ul>
    </section>
  </div>

  <Engagements />
  <Reviews />
  <ConversionBlock source="Site principal - Professionnels" service="Professionnel - Dératisation / désinsectisation" title="Un nuisible dans votre établissement ? Parlons-en maintenant" />
  <Faq items={FAQ} title="Vos questions de professionnels" />
  <FinalCta title="Un problème de nuisibles dans votre établissement ?" />
</Base>
