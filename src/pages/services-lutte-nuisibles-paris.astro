---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import CallButton from '../components/CallButton.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ConversionBlock from '../components/ConversionBlock.astro';

import { GENERAL_FAQ, PESTS_ALL } from '../data/site';
import { breadcrumbLd, localBusinessLd } from '../lib/seo';

const path = '/services-lutte-nuisibles-paris/';
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Nos services', path }];
const BIG = [
  { icon: 'target', title: 'Dératisation', text: 'Rats, souris, mulots : élimination rapide, prévention durable.', to: '/deratisation-paris/', img: '/images/deratisation-rat-capture-cage.webp', alt: 'Rat capturé dans une cage lors d’une dératisation' },
  { icon: 'bug', title: 'Désinsectisation', text: 'Cafards, punaises de lit, fourmis, puces, mites.', to: '/desinsectisation-cafards-blattes-idf/', img: '/images/traitement-cafards-blattes-cuisine.webp', alt: 'Technicien traitant une cuisine contre les cafards' },
  { icon: 'shield', title: 'Désinfection', text: 'Un environnement sain après l’infestation.', to: '/demander-un-devis/', img: '/images/traitement-punaises-de-lit-matelas.webp', alt: 'Technicien désinfectant un matelas dans un logement' },
];
const PROMISES = [
  { icon: 'shield', title: 'Qualité et expertise', text: 'Techniciens certifiés, méthodes éprouvées.' },
  { icon: 'clock', title: 'Réactivité', text: 'Joignables 24h/24, 7j/7, pour vos urgences.' },
  { icon: 'building', title: 'Particuliers et pros', text: 'Logements, copropriétés, restaurants, hôtels, commerces, bureaux.' },
];
---
<Base
  title="Services lutte nuisibles Paris & IDF | Elite Nuisibles IDF"
  description="Dératisation, désinsectisation, punaises de lit et désinfection à Paris et en Île-de-France. Intervention en moins d’1h, 7j/7, déplacement et devis gratuits."
  path={path}
  jsonLd={[localBusinessLd(), breadcrumbLd(crumbs)]}
>
  <PageHead crumbs={crumbs} title="Nos services de lutte contre les nuisibles" intro="À Paris et partout en Île-de-France, 7j/7. Déplacement et devis gratuits, prix fixes.">
    <div class="cta-row"><CallButton /><a class="btn btn-ghost" href="/demander-un-devis/">Demander un devis gratuit</a></div>
  </PageHead>

  <TrustStrip />

  <section class="section">
    <div class="container">
      <div class="grid grid-3 m-scroll">
        {BIG.map((s) => (
          <a class="glass post-card reveal" href={s.to}>
            <div class="thumb"><img src={s.img} alt={s.alt} loading="lazy" width="640" height="360" /></div>
            <div class="body">
              <h2 class="h3" style="font-size:22px">{s.title}</h2>
              <p>{s.text}</p>
              <span class="link-arrow" style="margin-top:auto">Découvrir <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Tous les nuisibles</span>
        <h2 class="h2">Une solution pour chaque nuisible</h2>
        <p class="lead">Techniques professionnelles et produits homologués.</p>
      </div>
      <div class="grid grid-3 m-scroll">
        {PESTS_ALL.map((p) => (
          <a class="glass card reveal" href={p.to} style="border-radius:22px;padding:22px">
            <h3 class="h3" style="font-size:18px">{p.name}</h3>
            <p class="muted" style="font-size:15px">{p.desc}</p>
            <span class="more">En savoir plus <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">Notre engagement</span><h2 class="h2">Qualité, réactivité, sécurité</h2></div>
      <div class="grid grid-3 m-scroll">
        {PROMISES.map((e) => (
          <div class="glass feature reveal"><span class="ico"><Icon name={e.icon} size={22} /></span><div><h3>{e.title}</h3><p>{e.text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <Reviews />
  <ConversionBlock source="Site principal - Services" />
  <Faq items={GENERAL_FAQ} />
  <FinalCta />
</Base>
